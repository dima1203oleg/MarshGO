# Copy to .env.production, replace every example and protect with chmod 600.
NODE_ENV=production
APP_DOMAIN=marshgo.example.com
API_PORT=3002
MARSHGO_RELEASE_TAG=replace-with-immutable-release-tag
BACKUP_DATABASE=marshgo
POSTGRES_PASSWORD=replace-with-generated-secret
REDIS_PASSWORD=replace-with-generated-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=https://marshgo.example.com,capacitor://localhost
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-verified-sender
OSRM_URL=https://routing.example.com/route/v1/driving
GEOCODING_ENGINE_URL=https://geocoder.example.com/search
GEOCODING_REVERSE_URL=https://geocoder.example.com/reverse
GEOCODING_API_KEY=
MAP_STYLE_MANIFEST_URL=https://maps.example.com/v1/style-manifest.json
MAP_DATA_MANIFEST_URL=https://maps.example.com/v1/data-manifest.json
VITE_MAP_STYLE_MANIFEST_URL=https://maps.example.com/v1/style-manifest.json
S3_BUCKET=marshgo-private
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
HERE_ROUTING_ENABLED=false
HERE_TRAFFIC_ENABLED=false
TOMTOM_ROUTING_ENABLED=false
TOMTOM_TRAFFIC_ENABLED=false
BACKUP_KEY_FILE=/etc/marshgo/backup-passphrase
