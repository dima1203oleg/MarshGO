FROM oven/bun:1.3.5-alpine AS build
WORKDIR /src
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY server ./server
COPY shared ./shared
RUN ./node_modules/.bin/esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=/out/server.mjs \
 && ./node_modules/.bin/esbuild server/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=/out/server/migrate.mjs

FROM oven/bun:1.3.5-alpine AS production-dependencies
WORKDIR /src
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM node:24.21.0-alpine AS runtime
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=3002
WORKDIR /app
COPY --from=production-dependencies --chown=node:node /src/node_modules ./node_modules
COPY --from=build --chown=node:node /out/server.mjs ./server.mjs
COPY --from=build --chown=node:node /out/server/migrate.mjs ./server/migrate.mjs
COPY --from=build --chown=node:node /src/server/migrations ./server/migrations
COPY --chown=node:node package.json ./package.json
USER node
EXPOSE 3002
HEALTHCHECK --interval=20s --timeout=3s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3002/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
