{
  "name": "marshgo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server tests e2e scripts/ensure-e2e-database.ts playwright.config.ts src/App.tsx src/components/AppHeader.tsx src/services/storage.ts src/services/productionApi.ts src/views/HomeView.tsx src/views/SearchView.tsx src/views/ProductionMarketplace.tsx src/views/ProductionNavigation.tsx vite.config.ts eslint.config.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/build-pwa.mjs && playwright test",
    "test:integration:bookings": "tsx --test tests/api-bookings.integration.test.ts",
    "test:integration:navigation": "tsx --test tests/navigation.integration.test.ts",
    "test:integration:realtime": "tsx --test tests/realtime-cluster.integration.test.ts",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "api": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:simulator": "bash scripts/build-ios-simulator.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-presigned-post": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^5.12.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
