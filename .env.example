# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# The production API-backed UI is the default. Opt in only to the localStorage demo.
VITE_DEMO_MODE=false

# Local API infrastructure. Copy this file to .env and replace all example secrets.
# docker compose binds these services to 127.0.0.1 only.
NODE_ENV=development
API_PORT=3002
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgres://marshgo:local_only_change_me@127.0.0.1:5434/marshgo
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost

# Local-only Adobe S3Mock from docker-compose.yml; never use it in production.
S3_BUCKET=marshgo-private
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9090
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# Local API development only. Production always requires a valid server session.
AUTH_DEV_BYPASS=false
AUTH_DEV_OTP=false

# Production launch blockers; keep unset until real providers and accounts exist.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SESSION_SECRET=
# Account deletion cooling-off period in days (7–90; default 30). Purge is not automatic.
ACCOUNT_DELETION_COOLING_OFF_DAYS=30
# OSRM-compatible self-hosted/contracted route endpoint, e.g. https://router.example/route/v1/driving
ROUTING_ENGINE_URL=
OSRM_URL=
ROUTING_PRIMARY=osrm
TRAFFIC_PROVIDER=none
MAP_RENDERER=maplibre
MAP_DATA_PROVIDER=marshgo
MAP_STYLE_MANIFEST_URL=
MAP_DATA_MANIFEST_URL=
# Nominatim-compatible HTTPS endpoint; self-host or contract for production use.
GEOCODING_ENGINE_URL=
GEOCODING_REVERSE_URL=
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
# Confirmed-booking rendezvous defaults: ephemeral participant locations use Redis only.
RENDEZVOUS_GEOFENCE_METERS=75
RENDEZVOUS_LEAD_MINUTES=15
# Map tile service URL template and attribution are public client configuration, not secrets.
# Use a contracted/self-hosted tile service; do not point production at the public OSM demo tiles.
VITE_MAP_STYLE_MANIFEST_URL=
# Legacy direct style URL and raster fixture configuration; production uses a versioned MARSHGO manifest.
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
# S3-compatible private bucket; use workload identity/instance roles where possible.
# Private S3-compatible bucket only; enforce server-side encryption, block public access, lifecycle expiry, and CORS for the app origin before enabling uploads.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=

# Phones that receive the admin role after verified sign-in (comma-separated E.164). Ignored while the development OTP is visible.
ADMIN_PHONES=
