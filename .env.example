# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local API infrastructure. Copy this file to .env and replace all example secrets.
# docker compose binds these services to 127.0.0.1 only.
NODE_ENV=development
API_PORT=3002
API_HOST=127.0.0.1
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgres://marshgo:local_only_change_me@127.0.0.1:5434/marshgo
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local API development only. Production always requires a valid server session.
AUTH_DEV_BYPASS=false
AUTH_DEV_OTP=false

# Production launch blockers; keep unset until real providers and accounts exist.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SESSION_SECRET=
# OSRM-compatible self-hosted/contracted route endpoint, e.g. https://router.example/route/v1/driving
ROUTING_ENGINE_URL=
# S3-compatible private bucket; use workload identity/instance roles where possible.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
